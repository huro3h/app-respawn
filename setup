#!/usr/bin/env ruby
# frozen_string_literal: true

# app-respawn のセットアップ。
#   1. LaunchAgent の plist をテンプレートから生成して読み込ませる。
#      plist には ruby とスクリプトの絶対パスが要るので、静的ファイルでは持ち運べない。
#   2. PATH の通ったディレクトリに本体へのシンボリックリンクを張る。
#
#   exit 0 = OK / 2 = エラー

require 'optparse'
require 'open3'
require 'rbconfig'
require 'fileutils'

LABEL     = 'local.app-respawn'
TOOL_ROOT = File.expand_path(__dir__)
TEMPLATE  = File.join(TOOL_ROOT, "#{LABEL}.plist.template")
SCRIPT    = File.join(TOOL_ROOT, 'app-respawn')
DEST      = File.join(Dir.home, 'Library', 'LaunchAgents', "#{LABEL}.plist")
LOG       = File.join(Dir.home, 'Library', 'Logs', 'app-respawn.log')

# コマンド名で呼べるようにリンクを置く先の候補(優先順)。特定のパスを1つ直書きしないのは
# Homebrew の prefix が Apple Silicon と Intel で違うため。PATH を総当たりしないのは、
# rbenv/pyenv の shims や conda の bin が書き込み可能なまま先頭に来ており、
# そこへ置くと rehash や環境切り替えで消えるから。
LINK_CANDIDATES = ['/opt/homebrew/bin', '/usr/local/bin', File.join(Dir.home, 'bin')].freeze

def die(msg, code = 2) = (warn "error: #{msg}"; exit code)

# PATH に入っていて書き込める候補の先頭を選ぶ。見つからなければ nil(リンクは張らない)。
def link_dir
  path = ENV['PATH'].to_s.split(File::PATH_SEPARATOR)
  LINK_CANDIDATES.find { |d| path.include?(d) && File.directory?(d) && File.writable?(d) }
end

opts = {}
OptionParser.new do |o|
  o.banner = "Usage: app-respawn/setup [--apply]\n\n" \
             "  LaunchAgent(#{LABEL})を生成して読み込み、PATH にリンクを張る。既定はドライラン。\n\n"
  o.on('--apply', '実際に書き込んで読み込む') { opts[:apply] = true }
  o.on('--uninstall', 'LaunchAgent とリンクを削除する') { opts[:uninstall] = true }
  o.on('--no-link', 'PATH へのシンボリックリンクを作らない') { opts[:no_link] = true }
  o.on('-h', '--help') { puts o; exit 0 }
end.parse!(ARGV)

uid = Process.uid
dir = opts[:no_link] ? nil : link_dir
link = dir && File.join(dir, 'app-respawn')

# 自分が張ったリンクだけを消す。同名の別物を巻き込まないため実体を確認する。
def our_link?(link)
  link && File.symlink?(link) && File.realpath(link) == SCRIPT
rescue Errno::ENOENT # 壊れたリンク
  false
end

if opts[:uninstall]
  unless opts[:apply]
    puts "削除する: #{DEST} (+ launchctl bootout)"
    puts "削除する: #{link}" if our_link?(link)
    puts '  実行するには --apply を付けてください'
    exit 0
  end
  Open3.capture3('launchctl', 'bootout', "gui/#{uid}/#{LABEL}")
  File.delete(DEST) if File.exist?(DEST)
  File.delete(link) if our_link?(link)
  puts "削除しました: #{LABEL}"
  exit 0
end

die("テンプレートがありません: #{TEMPLATE}") unless File.exist?(TEMPLATE)
die("実行ファイルがありません: #{SCRIPT}") unless File.executable?(SCRIPT)

# rbenv の shim は launchd から解決できないので、実体の ruby を埋める。
plist = File.read(TEMPLATE)
            .gsub('{{LABEL}}', LABEL)
            .gsub('{{RUBY}}', RbConfig.ruby)
            .gsub('{{SCRIPT}}', SCRIPT)
            .gsub('{{LOG}}', LOG)

link_note =
  if opts[:no_link] then '(--no-link のため作らない)'
  elsif link.nil?   then '(PATH に書き込める候補が無いため作らない)'
  else link
  end

unless opts[:apply]
  puts "生成先: #{DEST}"
  puts "  ruby   : #{RbConfig.ruby}"
  puts "  script : #{SCRIPT}"
  puts "  log    : #{LOG}"
  puts "  link   : #{link_note}"
  puts "\n実際に書き込んで読み込むには --apply を付けてください"
  exit 0
end

FileUtils.mkdir_p(File.dirname(DEST))
File.write(DEST, plist)
_, err, st = Open3.capture3('plutil', '-lint', DEST)
die("plist が不正です: #{err}") unless st.success?

Open3.capture3('launchctl', 'bootout', "gui/#{uid}/#{LABEL}") # 既存があれば外す
_, err, st = Open3.capture3('launchctl', 'bootstrap', "gui/#{uid}", DEST)
die("launchctl bootstrap に失敗: #{err}") unless st.success?

puts "LaunchAgent を読み込みました: #{LABEL}"

if link.nil?
  puts "PATH へのリンクは作りませんでした #{link_note}"
elsif File.exist?(link) && !our_link?(link)
  # 別物を黙って上書きすると気付けないので、消さずに知らせるだけにする。
  warn "警告: #{link} が既にあるためリンクを作りませんでした"
else
  File.delete(link) if File.symlink?(link) || File.exist?(link)
  File.symlink(SCRIPT, link)
  puts "PATH にリンクしました: #{link} -> #{SCRIPT}"
end

puts "  ログ: tail -f #{LOG}"
